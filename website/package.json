{
  "name": "dal-data-ai-lab-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run verify",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "deploy": "node scripts/release.mjs",
    "db:generate": "drizzle-kit generate",
    "test:unit": "node --test tests/*.test.mjs",
    "typegen": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types worker-configuration.d.ts --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit --incremental false && tsc --project tsconfig.worker.json --noEmit --incremental false",
    "verify": "npm run lint && npm run build && npm run typegen && npm run typecheck && npm run test:unit",
    "release:check": "node scripts/release.mjs --check",
    "check:structure": "node --test tests/site-health.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "packageManager": "npm@12.0.2"
}
